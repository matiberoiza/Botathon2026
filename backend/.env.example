# Copia este archivo como backend/.env si necesitas cambiar algo (backend/.env no se sube a git).
# Sin .env, se usan estos mismos valores por defecto.

# Archivo de la base SQLite (ruta relativa a la carpeta del proyecto)
DB_RUTA=data/planificacion.db

# Carpeta con el archivo de parámetros y el de entradas de planificación (carga inicial)
CARPETA_GENERADOS=data/generados

# Frontend que puede llamar a la API
ORIGENES_FRONTEND=http://localhost:5173
